        "cursor": "pointer",
        "isWholeLine": false,
        "fontWeight": "900",
        "textDecoration": "underline overline dotted"
    },
    "todohighlight.exclude": [
        "**/node_modules/**",
        "**/bower_components/**",
        "**/dist/**",
        "**/build/**",
        "**/.vscode/**",
        "**/.github/**",
        "**/_output/**",
        "**/*.min.*",
        "**/*.map",
        "**/.next/**"
    ],
    "todohighlight.include": [
        "**/*.js",
        "**/*.ts",
        "**/*.html",
        "**/*.css",
        "**/*.scss"
    ],
    "todohighlight.isCaseSensitive": false,
    "todohighlight.keywords": [
        "DEBUG:",
        "REVIEW:",
        {
            "text": "NOTE:",
            "color": "#ffff00"
        },
        {
            "text": "HACK:",
            "color": "#ff9900"
        },
        {
            "text": "QUESTION:",
            "color": "#099fff"
        },
        {
            "text": "FIXME:",
            "color": "#ff0000",
            "backgroundColor": "#1e1e1e"
        },
        {
            "text": "TODO:",
            "color": "#00ff00",
            "backgroundColor": "#1e1e1e"
        }
    ],
    "todohighlight.maxFilesForSearch": 5120,
    "todohighlight.toggleURI": false,
    "vsicons.dontShowNewVersionMessage": true,
    "vue.format.template.initialIndent": false,
    "workbench.colorTheme": "Activate UMBRA protocol",
    "workbench.editor.defaultBinaryEditor": "default",
    "workbench.editor.tabSizing": "fixed",
    "workbench.editor.tabSizingFixedMaxWidth": 160,
    "workbench.editor.wrapTabs": true,
    "workbench.iconTheme": "vscode-icons",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.sideBar.location": "right"
